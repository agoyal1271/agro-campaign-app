BATCH_BREAK_HOURS=4
MAX_DAILY_SENDS=150
SEND_HOURS_START=10
SEND_HOURS_END=14
DAYS_TO_SEND=1,3,5
MAX_CONTACTS_PER_UPLOAD=1000

# Monitoring Thresholds
BLOCK_RATE_THRESHOLD=0.02
FAILURE_RATE_THRESHOLD=0.10
AUTO_PAUSE_ENABLED=true
