{
  "name": "agro-campaign-app",
  "version": "1.0.0",
  "description": "Local WhatsApp campaign management app for agricultural buyers",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "build-exe": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.ganeshagro.campaignmanager",
    "productName": "Ganesh Agro Campaign Manager",
    "files": [
      "**/*",
      "!build",
      "!dist",
      "!.wwebjs_auth",
      "!campaigns.json",
      "!*.log",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ganesh Agro Campaign Manager"
    }
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "nodemon": "^3.0.1"
  },
  "author": "",
  "license": "ISC"
}
